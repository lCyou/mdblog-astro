---
interface Props {
  manTitle: string;
  /** 中央に出すテキスト（日付や (END) など） */
  center?: string;
}

const { manTitle, center } = Astro.props;
---

<footer class="container">
  <div class="man-foot">
    <span>lcyou</span>
    {center && <span class="center">{center}</span>}
    <span>{manTitle}</span>
  </div>
</footer>

<style>
  .man-foot {
    display: flex;
    justify-content: space-between;
    padding: 20px 0 24px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .man-foot {
      padding: 16px 0 24px;
      font-size: 12px;
    }

    .center {
      display: none;
    }
  }
</style>
