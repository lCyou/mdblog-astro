---
export type NavKey = 'home' | 'blog' | 'about' | 'tags' | 'search';

interface Props {
  /** 左右に出す man ページ風のタイトル（例: LCYOU(7)） */
  manTitle: string;
  /** 中央のタイトル */
  manCenter?: string;
  current?: NavKey;
}

const { manTitle, manCenter = "lCyou's Blog Manual", current } = Astro.props;

const items: { key: NavKey; href: string; label: string }[] = [
  { key: 'home', href: '/', label: 'home' },
  { key: 'blog', href: '/blog/', label: 'blog' },
  { key: 'about', href: '/about/', label: 'about' },
  { key: 'tags', href: '/tags/', label: 'tags' },
  { key: 'search', href: '/search/', label: 'search' },
];
---

<div class="site-header">
  <header class="container">
    <div class="man-line">
      <span class="man-title">{manTitle}</span>
      <span class="man-center">{manCenter}</span>
      <span class="man-title man-right" aria-hidden="true">{manTitle}</span>
      <div class="mobile-actions">
        <a href="/search/" class="icon-btn" aria-label="検索">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        </a>
        <button type="button" class="icon-btn theme-toggle" aria-label="テーマを切り替え">
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
      </div>
    </div>
    <nav aria-label="メイン" class="tabs">
      {
        items.map((item, i) => (
          <a
            href={item.href}
            class:list={['tab', `tab-${item.key}`]}
            aria-current={current === item.key ? 'page' : undefined}
          >
            <span class="tab-num">{i + 1}:</span>
            {item.label}
          </a>
        ))
      }
      <span class="tab-spacer"></span>
      <a href="/rss.xml" class="tab tab-rss">rss</a>
      <button type="button" class="icon-btn theme-toggle desktop-toggle" aria-label="テーマを切り替え">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </nav>
  </header>
</div>

<script is:inline>
  document.querySelectorAll('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .man-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 0 14px;
    font-size: 14px;
    color: var(--muted);
  }

  .mobile-actions {
    display: none;
  }

  .tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-bottom: 14px;
    font-size: 15px;
  }

  .tab {
    padding: 10px 14px;
    color: inherit;
    text-decoration: none;
  }

  .tab:hover {
    color: var(--accent);
  }

  .tab-num {
    color: var(--muted);
  }

  .tab[aria-current='page'] {
    background: var(--inv);
    color: var(--inv-text);
  }

  .tab[aria-current='page'] .tab-num {
    color: inherit;
    opacity: 0.6;
  }

  .tab-spacer {
    flex-grow: 1;
  }

  .tab-rss {
    color: var(--muted);
  }

  .icon-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--text);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .icon-sun {
    display: none;
  }

  :global(html.dark) .icon-sun {
    display: block;
  }

  :global(html.dark) .icon-moon {
    display: none;
  }

  @media (max-width: 767px) {
    .man-line {
      height: 52px;
      padding: 0;
      font-size: 13px;
    }

    .man-center,
    .man-right {
      display: none;
    }

    .mobile-actions {
      display: flex;
      margin-right: -10px;
    }

    .mobile-actions .icon-btn {
      border: 0;
    }

    .tabs {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      padding-bottom: 12px;
      font-size: 14px;
    }

    .tab {
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 1px solid var(--rule);
    }

    .tab[aria-current='page'] {
      border-color: var(--inv);
    }

    .tab-num,
    .tab-search,
    .tab-spacer,
    .tab-rss,
    .desktop-toggle {
      display: none;
    }
  }
</style>
