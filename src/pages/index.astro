---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TerminalHero from '@/components/TerminalHero.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/data/seo';

const pageTitle = "Home";
const description = siteConfig.description;

// 最新記事を取得（/blog/ と同じロジック）
const allPosts = Object.values(import.meta.glob('./posts/**/*.md', { eager: true }))
  .sort((a: any, b: any) => {
    const aDate = new Date(a.frontmatter.pubDate);
    const bDate = new Date(b.frontmatter.pubDate);
    return bDate.getTime() - aDate.getTime();
  });

// おすすめ記事：最新 5 件（tech/life 混在）
const recommended = allPosts.slice(0, 5);

const categoryOf = (post: any) =>
  post.frontmatter.tags?.includes('tech') ? 'tech' : 'life';
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <h1 class="sr-only">lCyou's Blog</h1>

  <TerminalHero />

  <section class="recommended" aria-label="おすすめ記事">
    <h2>最新の記事</h2>
    <ul>
      {
        recommended.map((post: any) => {
          const category = categoryOf(post);
          return (
            <li class={`post-item post-${category}`}>
              <a href={post.url}>
                <Icon
                  name={category === 'tech' ? 'mdi:code-tags' : 'mdi:heart'}
                  class="category-icon"
                />
                <span class="post-title">{post.frontmatter.title}</span>
                <span class="post-date">
                  {post.frontmatter.pubDate.toString().slice(0, 10)}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="more-link">
      <a href="/blog/">すべての記事を見る →</a>
    </p>
  </section>

  <style>
    .recommended {
      max-width: 760px;
      margin: 0 auto;
    }

    .recommended h2 {
      font-size: 1.4rem;
      border-bottom: 2px solid var(--color-border);
      padding-bottom: 0.5rem;
    }

    .post-item a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      text-decoration: none;
      color: var(--color-text);
    }

    .category-icon {
      font-size: 1.2rem;
      flex-shrink: 0;
      color: var(--color-text);
      transition: color 0.2s ease;
    }

    .post-title {
      flex: 1;
    }

    .post-date {
      font-size: 0.9rem;
      opacity: 0.7;
      flex-shrink: 0;
    }

    .more-link {
      margin-top: 1rem;
      text-align: right;
    }

    .more-link a {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 600;
    }

    .more-link a:hover {
      text-decoration: underline;
    }
  </style>
</BaseLayout>
