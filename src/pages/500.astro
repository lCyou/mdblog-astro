---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  pageTitle="500 Server Error"
  description="サーバーでエラーが発生しました。"
  manTitle="ERRNO(5)"
  status={{ path: '~/blog/500', info: ['E500'] }}
  noindex
>
  <main class="container man-sections">
    <div class="error">
      <p class="cmd"><span class="accent">$</span> make blog</p>
      <h1>500: Internal Server Error</h1>
      <p class="desc">
        申し訳ありません。サーバーでエラーが発生しました。問題が解決しない場合は、
        <a href="https://twitter.com/lCyo_u">X</a> か <a href="https://bsky.app/profile/lcyou.bsky.social">Bluesky</a>
        までお知らせください。
      </p>
      <ul class="chip-list">
        <li><a href="/" class="chip">cd ~</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>

<style>
  .error {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px 0;
  }

  .cmd {
    margin: 0;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
  }

  .desc {
    margin: 0 0 8px;
    color: var(--body);
    line-height: 1.9;
  }

  .desc a {
    color: var(--accent);
  }

  @media (max-width: 767px) {
    h1 {
      font-size: 20px;
    }
  }
</style>
