---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import { CATEGORY_TAGS, getPosts, getTagCounts } from '@/utils/posts';
import { siteConfig } from '@/data/seo';

const posts = getPosts();
const tagCounts = getTagCounts(posts);
const categories = CATEGORY_TAGS.map((tag) => ({
  tag,
  count: tagCounts.find((t) => t.tag === tag)?.count ?? 0,
})).filter((c) => c.count > 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `記事一覧 | ${siteConfig.title}`,
    url: `${siteConfig.url}/blog/`,
    inLanguage: 'ja',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts
        .filter((post) => !post.noindex)
        .map((post, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${siteConfig.url}${post.url}`,
        name: post.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'home', item: `${siteConfig.url}/` },
      { '@type': 'ListItem', position: 2, name: 'blog', item: `${siteConfig.url}/blog/` },
    ],
  },
];
---

<BaseLayout
  pageTitle="記事一覧"
  description={`${siteConfig.title} の記事一覧（全${posts.length}件）。技術的なこと、イベントの感想、エッセイなど。`}
  manTitle="BLOG(5)"
  current="blog"
  footerCenter="(END)"
  status={{ path: '~/blog/posts/', info: [`--all  ${posts.length} files`] }}
  jsonLd={jsonLd}
>
  <main class="container man-sections">
    <h1 class="page-title">記事一覧<span class="muted">{posts.length} posts · 新しい順</span></h1>

    <section class="man-section" aria-labelledby="options-label">
      <h2 class="man-label" id="options-label">OPTIONS</h2>
      <ul class="chip-list">
        <li><a href="/blog/" class="chip" aria-current="page">--all {posts.length}</a></li>
        {
          categories.map(({ tag, count }) => (
            <li>
              <a href={`/tags/${tag}/`} class="chip">
                <span class="flag">--tag </span>
                {tag} <span class="muted">{count}</span>
              </a>
            </li>
          ))
        }
        <li><a href="/tags/" class="chip all-tags">すべてのタグ →</a></li>
      </ul>
    </section>

    <form action="/search/" method="get" role="search" class="search-form">
      <label for="blog-search" class="prompt">/<span class="sr-only">記事を検索</span></label>
      <input id="blog-search" name="q" type="search" placeholder="記事を検索" autocomplete="off" />
      <button type="submit">&lt;CR&gt;</button>
    </form>

    <PostList posts={posts} />
  </main>
</BaseLayout>

<style>
  .page-title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    font-size: 30px;
    font-weight: 600;
  }

  .page-title .muted {
    font-size: 15px;
    font-weight: 400;
  }

  .search-form {
    display: flex;
    align-items: center;
    max-width: 560px;
    margin: -24px 0 0 200px;
    border: 1px solid var(--text);
    background: var(--card);
  }

  .prompt {
    padding: 0 4px 0 14px;
    font-size: 15px;
    color: var(--accent);
  }

  .search-form input {
    flex-grow: 1;
    min-width: 0;
    height: 46px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    color: var(--text);
    outline: none;
  }

  .search-form button {
    height: 48px;
    padding: 0 20px;
    margin: -1px -1px -1px 0;
    background: var(--inv);
    color: var(--inv-text);
    border: 0;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .search-form:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .all-tags {
    border-color: transparent;
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .page-title {
      font-size: 22px;
      gap: 4px 12px;
    }

    .page-title .muted {
      font-size: 13px;
    }

    .flag {
      display: none;
    }

    .search-form {
      margin: -20px 0 0;
    }

    .search-form button {
      padding: 0 14px;
      font-size: 13px;
    }
  }
</style>
