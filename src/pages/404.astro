---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  pageTitle="404 Not Found"
  description="お探しのページは見つかりませんでした。"
  manTitle="ERRNO(2)"
  status={{ path: '~/blog/404', info: ['E404'] }}
  noindex
>
  <main class="container man-sections">
    <div class="error">
      <p class="cmd"><span class="accent">$</span> cd <span data-error-path>this-page</span></p>
      <h1>404: No such file or directory</h1>
      <p class="desc">
        お探しのページは見つかりませんでした。URL が間違っているか、ページが移動・削除された可能性があります。
      </p>
      <ul class="chip-list">
        <li><a href="/" class="chip">cd ~</a></li>
        <li><a href="/blog/" class="chip">ls posts/</a></li>
        <li><a href="/search/" class="chip">grep</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  const el = document.querySelector('[data-error-path]');
  if (el) el.textContent = window.location.pathname;
</script>

<style>
  .error {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px 0;
  }

  .cmd {
    margin: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
  }

  .desc {
    margin: 0 0 8px;
    color: var(--body);
    line-height: 1.9;
  }

  @media (max-width: 767px) {
    h1 {
      font-size: 20px;
    }
  }
</style>
