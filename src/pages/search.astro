---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/seo';
---

<BaseLayout
  pageTitle="検索"
  description={`${siteConfig.title} の記事を検索します。`}
  manTitle="SEARCH(1)"
  current="search"
  status={{ path: '~/blog/search', info: ['grep -r'] }}
  noindex
>
  <main class="container man-sections">
    <h1 class="page-title">検索</h1>
    <div id="search" class="search-container"></div>
    <noscript><p class="muted">検索には JavaScript が必要です。<a href="/blog/">記事一覧</a>からも探せます。</p></noscript>
  </main>
</BaseLayout>

<style>
  .page-title {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .page-title {
      font-size: 22px;
    }
  }
</style>

<style is:global>
  /* Pagefind UI */
  .search-container {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--card);
    --pagefind-ui-border: var(--text);
    --pagefind-ui-tag: var(--card);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-mono);
  }

  .search-container .pagefind-ui__result-link {
    color: var(--text);
  }

  .search-container .pagefind-ui__result-excerpt {
    color: var(--body);
  }

  .search-container .pagefind-ui__result {
    border-top-color: var(--rule);
  }

  .search-container mark {
    background-color: var(--accent);
    color: var(--bg);
    padding: 0 2px;
  }
</style>

<script>
  import { PagefindUI } from '@pagefind/default-ui';
  import '@pagefind/default-ui/css/ui.css';

  const ui = new PagefindUI({
    element: '#search',
    showSubResults: false,
    translations: {
      placeholder: '記事を検索...',
      zero_results: '[SEARCH_TERM] の検索結果はありませんでした。',
    },
  });

  // /search/?q=... で来たときはその語で検索する
  const q = new URLSearchParams(window.location.search).get('q');
  if (q) ui.triggerSearch(q);
</script>
