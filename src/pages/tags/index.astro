---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTagCounts } from '@/utils/posts';
import { siteConfig } from '@/data/seo';

const tags = getTagCounts();
---

<BaseLayout
  pageTitle="タグ一覧"
  description={`${siteConfig.title} のタグ一覧。${tags.slice(0, 8).map((t) => t.tag).join('、')} など。`}
  manTitle="TAGS(7)"
  current="tags"
  footerCenter="(END)"
  status={{ path: '~/blog/tags/', info: [`${tags.length} tags`] }}
>
  <main class="container man-sections">
    <h1 class="page-title">タグ一覧<span class="muted">{tags.length} tags</span></h1>

    <section class="man-section" aria-labelledby="tags-label">
      <h2 class="man-label" id="tags-label">TAGS</h2>
      <ul class="chip-list">
        {
          tags.map(({ tag, count }) => (
            <li>
              <a href={`/tags/${tag}/`} class="chip">
                {tag} <span class="muted">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .page-title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    font-size: 30px;
    font-weight: 600;
  }

  .page-title .muted {
    font-size: 15px;
    font-weight: 400;
  }

  @media (max-width: 767px) {
    .page-title {
      font-size: 22px;
    }

    .page-title .muted {
      font-size: 13px;
    }
  }
</style>
