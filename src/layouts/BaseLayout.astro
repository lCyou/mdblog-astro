---
import { SEO } from 'astro-seo';
import Header, { type NavKey } from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StatusLine from '@/components/StatusLine.astro';
import '@/styles/global.css';
import { siteConfig } from '@/data/seo';

interface Props {
  /** <title> に使うページ名。省略するとサイト名だけになる（トップ用） */
  pageTitle?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** man ページ風ヘッダーのタイトル（例: BLOG(5)） */
  manTitle?: string;
  manCenter?: string;
  current?: NavKey;
  footerCenter?: string;
  status?: { path: string; branch?: string; info?: string[] };
  article?: { publishedTime: string; modifiedTime?: string; tags?: string[] };
  /** 構造化データ（JSON-LD）。配列なら複数出力する */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  pageTitle,
  description = siteConfig.description,
  ogImage,
  ogImageAlt,
  manTitle = 'LCYOU(7)',
  manCenter,
  current,
  footerCenter,
  status = { path: `~/blog${Astro.url.pathname}` },
  article,
  jsonLd,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') || siteConfig.url;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${siteUrl}${ogImage}`
  : `${siteUrl}${siteConfig.image}`;
const fullTitle = pageTitle ? `${pageTitle} | ${siteConfig.title}` : siteConfig.title;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={`${siteUrl}/rss.xml`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f2e2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1b18" media="(prefers-color-scheme: dark)" />
    <SEO
      title={fullTitle}
      description={description}
      canonical={pageUrl}
      noindex={noindex}
      openGraph={{
        basic: {
          title: pageTitle || siteConfig.title,
          type: article ? 'article' : 'website',
          image: ogImageUrl,
          url: pageUrl,
        },
        optional: {
          description,
          locale: siteConfig.locale,
          siteName: siteConfig.title,
        },
        image: {
          alt: ogImageAlt || pageTitle || siteConfig.title,
          width: 1200,
          height: 630,
        },
        article: article && {
          publishedTime: article.publishedTime,
          modifiedTime: article.modifiedTime,
          authors: [siteConfig.author],
          tags: article.tags,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        image: ogImageUrl,
        site: siteConfig.twitter,
        creator: siteConfig.twitter,
      }}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=M+PLUS+1+Code:wght@400;500;700&display=swap"
    />
    <script is:inline>
      // ページ描画前にテーマを適用（フラッシュ防止）
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    {jsonLdList.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">本文へスキップ</a>
    <Header manTitle={manTitle} manCenter={manCenter} current={current} />
    <div id="main" class="page">
      <slot />
    </div>
    <Footer manTitle={manTitle} center={footerCenter} />
    <StatusLine path={status.path} branch={status.branch} info={status.info} />
  </body>
</html>

<style>
  .page {
    flex-grow: 1;
  }

  .skip-link {
    position: absolute;
    left: 8px;
    top: -48px;
    padding: 8px 12px;
    background: var(--inv);
    color: var(--inv-text);
    z-index: 20;
  }

  .skip-link:focus {
    top: 8px;
  }
</style>
